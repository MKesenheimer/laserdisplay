        <destroy shape="spark_d2"/>
        <destroy shape="dia_m"/>
        <create shape="ch_m"/>
        <effect shape="ch_m" type="translate_by_path" path="p_ring" velocity="180"/>
        <create shape="ch_g"/>
        <effect shape="ch_g" type="translate_by_path" path="p_ring" velocity="-180"/>
    </event>

    <event at="177.1683">
        <create shape="accW"/>
        <effect shape="accW" type="mirror" axis="vertical"/>
        <effect shape="accW" type="blink" period="0.6" duty="0.2"/>
