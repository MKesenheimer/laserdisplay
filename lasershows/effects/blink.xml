<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: blink

    <effect shape="NAME" type="blink" period duty every/>
    period = seconds per on/off cycle, duty = on-fraction (0-1);
    every > 1 additionally blanks every n-th point while the shape is on
    (with duty="1.0" the shape never goes fully off - just dashed).

    - steady:  a calm 1.2 s pulse
    - flicker: a fast 0.25 s flicker with short on-times
    - dashed:  never off, but dashed while on
-->
<animation fps="25" duration="10">
    <!-- ==================== shape definitions ============================ -->
    <shape name="steady" type="line" x0="30" y0="170" x1="226" y1="170"
           npoints="40" red="255" green="255" blue="255"/>
    <shape name="flicker" type="triangle" x0="128" y0="173" x1="89" y1="106" x2="167" y2="106"
           npoints="24" red="255" green="200" blue="60"/>
    <shape name="dashed" type="circle" cx="128" cy="128" r="50"
           npoints="40" red="120" green="255" blue="180"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="steady"/>
        <effect shape="steady" type="blink" period="1.2" duty="0.6"/>
        <create shape="flicker"/>
        <effect shape="flicker" type="blink" period="0.25" duty="0.3"/>
        <create shape="dashed"/>
        <effect shape="dashed" type="blink" period="2.0" duty="1.0" every="4"/>
    </event>

    <event at="10.0">
        <destroy shape="steady"/>
        <destroy shape="flicker"/>
        <destroy shape="dashed"/>
    </event>
</animation>
