<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: blink (extracted from blink.xml)

    <effect shape="NAME" type="blink" period duty every/>
    period = seconds per on/off cycle, duty = on-fraction (0-1);
    every > 1 additionally blanks every n-th point while the shape is on
    (with duty="1.0" the shape never goes fully off - just dashed).

    - steady: a calm 1.2 s pulse
-->
<animation fps="25" duration="10">
    <!-- ==================== shape definitions ============================ -->
    <shape name="steady" type="line" x0="30" y0="170" x1="226" y1="170"
           npoints="40" red="255" green="255" blue="255"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="steady"/>
        <effect shape="steady" type="blink" period="1.2" duty="0.6"/>
    </event>

    <event at="10.0">
        <destroy shape="steady"/>
    </event>
</animation>
