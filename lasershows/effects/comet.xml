<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: move_points (extracted from move_points.xml)

    <effect shape="NAME" type="move_points" points="SEL" dx dy [duration]/>
    or with tx/ty instead of dx/dy: move the selected points towards that
    absolute position (both required together). points selects a slice
    ("3:7", "-10:"), a list ("0,5,9") or a single index. duration > 0
    animates the move.

    - comet: the last quarter of a circle is pulled away, bulging the
      outline
-->
<animation fps="25" duration="10">
    <!-- ==================== shape definitions ============================ -->
    <shape name="comet" type="circle" cx="128" cy="128" r="45"
           npoints="40" red="120" green="220" blue="255"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="comet"/>
        <effect shape="comet" type="move_points" points="-10:" dx="30" dy="30" duration="2"/>
    </event>

    <event at="10.0">
        <destroy shape="comet"/>
    </event>
</animation>
