<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: blink (extracted from blink.xml)

    <effect shape="NAME" type="blink" period duty every/>
    period = seconds per on/off cycle, duty = on-fraction (0-1);
    every > 1 additionally blanks every n-th point while the shape is on
    (with duty="1.0" the shape never goes fully off - just dashed).

    - dashed: never off, but dashed while on
-->
<animation fps="25" duration="10">
    <!-- ==================== shape definitions ============================ -->
    <shape name="dashed" type="circle" cx="128" cy="128" r="50"
           npoints="40" red="120" green="255" blue="180"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="dashed"/>
        <effect shape="dashed" type="blink" period="2.0" duty="1.0" every="4"/>
    </event>

    <event at="10.0">
        <destroy shape="dashed"/>
    </event>
</animation>
