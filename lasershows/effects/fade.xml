<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: color_shift (extracted from color_shift.xml)

    <effect shape="NAME" type="color_shift" dr dg db/>
    Color change per second for each channel (0-255 scale); negative
    values fade a channel out, positive values raise it. Channels stop
    at black/white, they never wrap.

    - fade: a triangle fading completely out to black
-->
<animation fps="25" duration="12">
    <!-- ==================== shape definitions ============================ -->
    <shape name="fade" type="triangle" x0="128" y0="173" x1="89" y1="106" x2="167" y2="106"
           npoints="24" red="120" green="220" blue="255"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="fade"/>
        <effect shape="fade" type="color_shift" dr="-50" dg="-45" db="-30"/>
    </event>
</animation>
