<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: scale (extracted from scale.xml)

    <effect shape="NAME" type="scale" factor min max frequency center_x center_y/>
    Static enlargement with factor; pulsing (breathing) when frequency > 0,
    oscillating between the min and max factor. Scaling happens around
    center_x/center_y (default: frame center).

    - grow: a square pulsing fast; it is already centered on the frame,
      so it pulses in place (for off-center shapes set center_x/center_y
      to keep them where they are)
-->
<animation fps="25" duration="12">
    <!-- ==================== shape definitions ============================ -->
    <shape name="grow" type="tetragon" x0="98" y0="98" x1="158" y1="98"
           x2="158" y2="158" x3="98" y3="158"
           npoints="12" red="255" green="220" blue="90"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="grow"/>
        <effect shape="grow" type="scale" min="0.8" max="1.3" frequency="0.75"/>
    </event>

    <event at="12.0">
        <destroy shape="grow"/>
    </event>
</animation>
