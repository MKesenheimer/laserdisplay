<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: mirror (extracted from mirror.xml)

    <effect shape="NAME" type="mirror" axis/>
    adds an exactly mirrored copy of the shape at the middle vertical
    (axis="vertical", default, left/right) or horizontal (axis="horizontal",
    top/bottom) axis of the frame; the original stays untouched. A blanked
    point between both halves keeps the beam off while the scanner travels
    to the copy, so no line is drawn between them. Effects attached *after*
    the mirror act on the original and the copy alike; effects attached
    *before* are mirrored together with the shape.

    - orb: a waddling dot with its top/bottom mirror
      (filename prefixed with the effect name; color_shift.xml has its own "orb")
-->
<animation fps="25" duration="10">
    <!-- ==================== shape definitions ============================ -->
    <shape name="orb" type="circle" cx="128" cy="80" r="14"
           npoints="28" red="120" green="220" blue="255"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="orb"/>
        <effect shape="orb" type="translation" ax="30" fx="0.3"/>
        <effect shape="orb" type="mirror" axis="horizontal"/>
    </event>

    <event at="10.0">
        <destroy shape="orb"/>
    </event>
</animation>
