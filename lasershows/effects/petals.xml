<?xml version="1.0" encoding="UTF-8"?>
<!--
    Shape example: ellipse (extracted from ellipse.xml)

    <shape name="..." type="ellipse" cx cy w h npoints [blank] red green blue/>
    (cx/cy = center, w/h = horizontal/vertical dimension)

    - petal2: a horizontal ellipse spinning around the frame center against
      petal; together they form a slowly turning four-petal flower
-->
<animation fps="25" duration="12">
    <!-- ==================== shape definitions ============================ -->
    <shape name="petal" type="ellipse" cx="128" cy="128" w="26" h="84"
           npoints="48" red="255" green="140" blue="180"/>
    <shape name="petal2" type="ellipse" cx="128" cy="128" w="84" h="26"
           npoints="48" red="255" green="190" blue="120"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="petal"/>
        <effect shape="petal" type="rotation" speed="50"/>
        <create shape="petal2"/>
        <effect shape="petal2" type="rotation" speed="-50"/>
    </event>

    <event at="12.0">
        <destroy shape="petal"/>
        <destroy shape="petal2"/>
    </event>
</animation>