<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: scale

    <effect shape="NAME" type="scale" factor min max frequency center_x center_y/>
    Static enlargement with factor; pulsing (breathing) when frequency > 0,
    oscillating between the min and max factor. Scaling happens around
    center_x/center_y (default: frame center).

    - pulse: a circle breathing slowly around the frame center
    - grow:  a square pulsing fast, centered on itself via center_x/center_y
    - small: a triangle enlarged statically around its own center
-->
<animation fps="25" duration="12">
    <!-- ==================== shape definitions ============================ -->
    <shape name="pulse" type="circle" cx="128" cy="128" r="50"
           npoints="64" red="90" green="200" blue="255"/>
    <shape name="grow" type="tetragon" x0="98" y0="98" x1="158" y1="98"
           x2="158" y2="158" x3="98" y3="158"
           npoints="12" red="255" green="220" blue="90"/>
    <shape name="small" type="triangle" x0="60" y0="60" x1="100" y1="60" x2="80" y2="90"
           npoints="12" red="255" green="120" blue="160"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="pulse"/>
        <effect shape="pulse" type="scale" min="0.5" max="1.5" frequency="0.3"/>
        <create shape="grow"/>
        <!-- the square is already centered on the frame, so it pulses in
             place; for off-center shapes set center_x/center_y to keep
             them where they are (as "small" does below) -->
        <effect shape="grow" type="scale" min="0.8" max="1.3" frequency="0.75"/>
        <create shape="small"/>
        <effect shape="small" type="scale" factor="1.8" center_x="80" center_y="70"/>
    </event>

    <event at="12.0">
        <destroy shape="pulse"/>
        <destroy shape="grow"/>
        <destroy shape="small"/>
    </event>
</animation>
