<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effect example: translation

    <effect shape="NAME" type="translation" vx vy ax ay fx fy phase/>
    vx/vy = constant velocity in units/second (0-255 scale);
    ax/ay = sinusoidal wobble amplitude, fx/fy its frequency in Hz,
    phase shifts the wobble (radians).

    - drift: a dot crossing the whole frame diagonally (constant velocity)
    - bob:   a triangle bobbing up and down (wobble only, no velocity)
    - sway:  an ellipse swaying left and right, phase-shifted by half a
             period against the usual wobble start
-->
<animation fps="25" duration="12">
    <!-- ==================== shape definitions ============================ -->
    <shape name="drift" type="circle" cx="20" cy="20" r="12"
           npoints="28" red="255" green="200" blue="80"/>
    <shape name="bob" type="triangle" x0="128" y0="173" x1="89" y1="106" x2="167" y2="106"
           npoints="24" red="80" green="255" blue="140"/>
    <shape name="sway" type="ellipse" cx="128" cy="128" w="60" h="36"
           npoints="48" red="200" green="120" blue="255"/>

    <!-- ======================== timeline ========================= -->
    <event at="0.0">
        <create shape="drift"/>
        <!-- 19 u/s * 12 s = 228 -> the dot ends at (248, 200) -->
        <effect shape="drift" type="translation" vx="19" vy="15"/>
        <create shape="bob"/>
        <effect shape="bob" type="translation" ay="35" fy="0.4"/>
        <create shape="sway"/>
        <effect shape="sway" type="translation" ax="40" fx="0.25" phase="1.57"/>
    </event>

    <event at="12.0">
        <destroy shape="drift"/>
        <destroy shape="bob"/>
        <destroy shape="sway"/>
    </event>
</animation>
