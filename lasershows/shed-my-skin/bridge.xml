<?xml version="1.0" encoding="UTF-8"?>
<animation fps="25" duration="25">
    <shape name="b_orb" type="circle" cx="128" cy="128" r="45"
           npoints="60" red="0" green="208" blue="255"/>
    <event at="0.0">
        <create shape="b_orb"/>
        <effect shape="b_orb" type="rainbow" cycles="3" speed="0.15"/>
        <effect shape="b_orb" type="rotation" speed="12"/>
        <effect shape="b_orb" type="scale" min="0.85" max="1.15" frequency="0.1"/>
    </event>
    <event at="25.0">
        <destroy shape="b_orb"/>
    </event>
</animation>
