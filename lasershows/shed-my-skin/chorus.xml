<?xml version="1.0" encoding="UTF-8"?>
<animation fps="25" duration="12">
    <shape name="c_circ1" type="circle" cx="40" cy="50" r="16"
           npoints="32" red="0" green="208" blue="255"/>
    <shape name="c_circ2" type="circle" cx="220" cy="180" r="16"
           npoints="32" red="0" green="208" blue="255"/>
    <shape name="c_dia" type="tetragon" x0="210" y0="130" x1="226" y1="114"
           x2="242" y2="130" x3="226" y3="146"
           npoints="16" red="255" green="255" blue="255"/>
    <event at="0.0">
        <create shape="c_circ1"/>
        <effect shape="c_circ1" type="translate_by_path" path="p_ring" velocity="70"/>
        <create shape="c_circ2"/>
        <effect shape="c_circ2" type="translate_by_path" path="p_ring" velocity="70" phase="0.5"/>
        <create shape="c_dia"/>
        <effect shape="c_dia" type="rotation" speed="120"/>
        <effect shape="c_circ1" type="mirror" axis="vertical"/>
    </event>
    <event at="12.0">
        <destroy shape="c_circ1"/>
        <destroy shape="c_circ2"/>
        <destroy shape="c_dia"/>
        <destroy shape="c_ell"/>
    </event>
</animation>
