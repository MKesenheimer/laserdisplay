<?xml version="1.0" encoding="UTF-8"?>
<animation fps="25" duration="40">
    <shape name="v2_tri" type="triangle" x0="30" y0="190" x1="20" y1="145" x2="58" y2="145"
           npoints="20" red="255" green="96" blue="144"/>
    <shape name="v2_tet" type="tetragon" x0="200" y0="30" x1="240" y1="30"
           x2="240" y2="70" x3="200" y3="70"
           npoints="16" red="255" green="96" blue="144"/>
    <event at="0.0">
        <create shape="v2_tri"/>
        <effect shape="v2_tri" type="translate_by_path" path="p_rect" velocity="60"/>
        <create shape="v2_tet"/>
        <effect shape="v2_tet" type="translate_by_path" path="p_eight" velocity="-50"/>
        <effect shape="v2_tri" type="color_shift" dr="3" dg="-5" db="-2"/>
    </event>
    <event at="40.0">
        <destroy shape="v2_tri"/>
        <destroy shape="v2_tet"/>
    </event>
</animation>
